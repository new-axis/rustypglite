  },
  "keywords": ["postgres", "postgresql", "embedded", "database", "testing", "pglite"],
  "license": "MIT",
  "dependencies": {
    "koffi": "^2"
  },
  "devDependencies": {
    "pg": "^8",
    "@types/pg": "^8",
    "typescript": "^5",
    "tsx": "^4"
  }
}
