{
  "name": "rustypglite",
  "version": "0.1.0",
  "description": "Embedded PostgreSQL server for Node.js — real Postgres, zero infrastructure",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "postinstall": "bash scripts/download-pg.sh",
